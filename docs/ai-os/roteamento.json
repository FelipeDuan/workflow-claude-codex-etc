{
  "schema_version": 3,
  "nota": "Política canônica executável pelo preflight consultivo. O preflight decide e sugere; nunca inicia agentes. IDs de modelos devem ser confirmados no host.",
  "decomposicao": {
    "haiku": "checagens, inventarios e verificacoes mecanicas",
    "sonnet": "docs e implementacao de rotina (nativo Claude Code)",
    "opus": "orquestracao e decisao de risco alto"
  },
  "guardrails": {
    "quota_desconhecida": "pedir verificacao real",
    "limite_fallback": 2,
    "executar_automaticamente": false,
    "revisor_independente_para_alto_risco": true,
    "nao_equivaler_assinatura_e_api": true,
    "proibir_autoinstalacao_plugins_terceiros": true
  },
  "antigravity_modelos": {
    "despachavel": false,
    "motivo": "Uso direto pelo Felipe no app ou CLI oficial. A FAQ do Google nao suporta envolver agy em agentes de terceiros nos planos de consumidor; ver ADR-0006.",
    "nota": "Referencia historica de modelos verificados em 09/11/2026 para uso direto do Felipe. O custo relativo e hipotese (Google nao publica pesos por modelo); sufixos -low/-medium/-high indicam nivel de raciocinio, nao risco da tarefa.",
    "pools": [
      "Gemini Models (5h e semanal)",
      "Claude and GPT models (5h e semanal)",
      "Gemini 4 Argon (semanal proprio)"
    ],
    "modelos": {
      "gemini-3.8-flash": {
        "custo_relativo": "menor (hipotese)",
        "forcas": "trivial, volume, leitura longa, contexto 1M, imagem"
      },
      "claude-sonnet-5-5": {
        "custo_relativo": "medio (hipotese)",
        "forcas": "implementacao rotineira, testes, docs"
      },
      "gemini-4-argon": {
        "custo_relativo": "alto; barra semanal propria (verificado)",
        "forcas": "segunda opiniao de outra familia, contexto 1M, imagem/video"
      },
      "claude-opus-5-5": {
        "custo_relativo": "maior (hipotese)",
        "forcas": "tarefa dificil; nao e revisao cross-family para codigo escrito por Claude"
      },
      "gpt-oss-120b-medium": {
        "custo_relativo": "desconhecido",
        "forcas": "fallback; pode sair em 18/11/2026"
      }
    }
  },
  "policy_version": "2026-11-09.1",
  "providers": {
    "claude": {
      "allowed_modes": [
        "plan",
        "default",
        "acceptEdits",
        "auto"
      ],
      "forbidden_modes": [
        "bypassPermissions"
      ],
      "thinking_required": false,
      "default_mode": "default",
      "default_thinking": null,
      "quota_metered": true
    },
    "codex": {
      "allowed_modes": [
        "auto",
        "auto-review"
